# HALI environment template
# Copy to .env and replace placeholder values for your machine or Railway service.

# App
ENVIRONMENT=development
LOG_LEVEL=info
API_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
# Local Docker defaults use docker-compose.yml, which exposes PostGIS on host port 5433.
# Railway must use the PostGIS service public TCP proxy URL, not the internal railway domain.
# Keep DATABASE_URL on postgresql+asyncpg:// for FastAPI/asyncpg configuration.
# Keep DATABASE_URL_RAW and MIGRATION_DATABASE_URL on postgresql:// for psql and Alembic.
DATABASE_URL=postgresql+asyncpg://hali:hali@localhost:5433/hali
DATABASE_URL_RAW=postgresql://hali:hali@localhost:5433/hali
MIGRATION_DATABASE_URL=postgresql://hali:hali@localhost:5433/hali

# Optional Railway/Postgres component variables for teammates who prefer split config.
# These are not required by the app when DATABASE_URL is set.
PGHOST=localhost
PGPORT=5433
PGDATABASE=hali
PGUSER=hali
PGPASSWORD=hali

# AI
# Leave ANTHROPIC_API_KEY empty to disable Claude-backed translation/action-card generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# AI ensemble fallbacks (both free tier, no card required)
# Gemini: https://aistudio.google.com/apikey
# Groq:   https://console.groq.com/keys
# Leave either empty to disable that fallback provider - the router skips it.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_MODEL=claude-sonnet-4-6
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_ENSEMBLE_ENABLED=true
AI_MIN_CLARITY_SCORE=0.6
AI_BACKLOG_BATCH_SIZE=10
AI_MAX_CONCURRENT_ALERTS=5
GROUND_TRUTH_UPGRADE_THRESHOLD=3

# Africa's Talking / USSD
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Admin API key
# Protects /api/admin/* endpoints via the X-Admin-Key header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty in dev to allow unauthenticated access (logs a warning).
ADMIN_API_KEY=

# Ingestion flags
ENABLE_SCHEDULER=true
ENABLE_GDACS=true
ENABLE_CHIRPS=true
ENABLE_GFS=true
ENABLE_GLOFAS=false
ENABLE_ICPAC=false
GDACS_URL=https://www.gdacs.org/xml/rss.xml

# Source credentials (only GloFAS needs one)
GLOFAS_CDS_API_KEY=
GLOFAS_CDS_URL=https://cds.climate.copernicus.eu/api
ICPAC_DIGILIB_BASE=http://digilib.icpac.net
CHIRPS_FTP_HOST=ftp.chc.ucsb.edu

# WhatsApp Cloud API (Meta)
# Setup: developers.facebook.com -> create app -> add WhatsApp product
# Free for testing with a test number (no business verification needed)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WhatsApp -> API Setup). Not the phone number
# ID: the Message Templates API is scoped to the WABA, not the number.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=hali_webhook_2026
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Frontend
VITE_API_URL=http://localhost:8000