# HALI environment template
# Copy to .env and replace placeholder values for your machine or Railway service.

# App
ENVIRONMENT=development
LOG_LEVEL=info
API_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
# Local Docker defaults use docker-compose.yml, which exposes PostGIS on host port 5433.
# Railway must use the PostGIS service public TCP proxy URL, not the internal railway domain.
# Keep DATABASE_URL on postgresql+asyncpg:// for FastAPI/asyncpg configuration.
# Keep DATABASE_URL_RAW and MIGRATION_DATABASE_URL on postgresql:// for psql and Alembic.
DATABASE_URL=postgresql+asyncpg://hali:hali@localhost:5433/hali
DATABASE_URL_RAW=postgresql://hali:hali@localhost:5433/hali
MIGRATION_DATABASE_URL=postgresql://hali:hali@localhost:5433/hali

# Optional Railway/Postgres component variables for teammates who prefer split config.
# These are not required by the app when DATABASE_URL is set.
PGHOST=localhost
PGPORT=5433
PGDATABASE=hali
PGUSER=hali
PGPASSWORD=hali

# AI
# Leave ANTHROPIC_API_KEY empty to disable Claude-backed translation/action-card generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Africa's Talking / USSD
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Ingestion flags
ENABLE_SCHEDULER=true
ENABLE_GDACS=true
ENABLE_CHIRPS=false
ENABLE_GFS=false
ENABLE_GLOFAS=false
ENABLE_ICPAC=false
GDACS_URL=https://www.gdacs.org/xml/rss.xml

# Frontend
VITE_API_URL=http://localhost:8000
