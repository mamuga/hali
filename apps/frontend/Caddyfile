# Caddy config for HALI React PWA
# Serves the Vite build output as a SPA — all routes fall back to index.html
# PORT is injected by Railway

:{$PORT:3000}

root * /srv

file_server

# SPA fallback — any path not matching a file returns index.html
try_files {path} /index.html

encode gzip

header {
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Cache-Control "public, max-age=31536000, immutable"
}

# Never cache the HTML shell
@html {
    path *.html
    path /
}
header @html Cache-Control "no-cache, no-store, must-revalidate"
