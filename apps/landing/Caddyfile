# Caddy config for the HALI landing site.
# Astro emits real multi-page HTML, so there is no SPA fallback here — a missing
# path should be a 404, not the home page.
# PORT is injected by Railway.

:{$PORT:3000}

root * /srv

encode gzip zstd

# Hashed assets and self-hosted fonts are immutable.
@immutable path /_astro/*
header @immutable Cache-Control "public, max-age=31536000, immutable"

# HTML is revalidated so a redeploy is picked up immediately.
@html path *.html /
header @html Cache-Control "no-cache, no-store, must-revalidate"

header {
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
}

file_server

handle_errors {
    respond "{err.status_code} {err.status_text}"
}
