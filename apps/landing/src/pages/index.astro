---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Pipeline from '../components/Pipeline.astro';
import Capabilities from '../components/Capabilities.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Stack from '../components/Stack.astro';
import Demo from '../components/Demo.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="HALI — early warning for the IGAD region"
  description="Satellite hazard data from 5 sources, translated into 10 languages by an AI ensemble and delivered over USSD, WhatsApp and an offline web app. No registration."
>
  <Nav />
  <main>
    <Hero />
    <Problem />
    <Pipeline />
    <Capabilities />
    <Ecosystem />
    <Stack />
    <Demo />
  </main>
  <Footer />
</Base>
