---
import Shot from './Shot.astro';
import { DEMO_VIDEO_URL, USSD_CODE } from '../config';
import { alertFeedMobile, reportToast, ussdLivelihood } from '../data/shots';

const inUse = [
  {
    src: alertFeedMobile,
    alt: 'HALI alert feed on a mobile viewport in dark mode.',
    caption: 'The alert feed at 390x844, dark mode. The PWA caches this for offline reading.',
  },
  {
    src: reportToast,
    alt: 'HALI report submission form with a success toast confirming the report was sent.',
    caption: 'A community report submitted from the PWA. Offline, it queues and sends later.',
  },
  {
    src: ussdLivelihood,
    alt: 'USSD menu listing all seven livelihood options for a live red drought alert.',
    caption: `A live red drought alert on ${USSD_CODE}, offering all 7 livelihoods on a feature phone.`,
  },
];
---

<section id="demo" class="scroll-mt-14 border-b border-border">
  <div class="mx-auto w-full max-w-[1120px] px-5 py-16 sm:px-8">
    <h2 class="text-[20px]">See it working</h2>
    <p class="mt-4 max-w-[720px] text-[15px] text-muted-foreground sm:text-[16px]">
      A walkthrough of the running system, then the same product on the three channels
      it ships on. Every screenshot below was captured against the deployed services,
      not mocked up.
    </p>

    {
      DEMO_VIDEO_URL && (
        <div class="mt-8 aspect-video w-full max-w-[900px] overflow-hidden rounded-sm border border-border bg-card">
          <iframe
            src={DEMO_VIDEO_URL}
            title="HALI product demo"
            class="h-full w-full"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {inUse.map((shot) => <Shot src={shot.src} alt={shot.alt} caption={shot.caption} width={360} />)}
    </div>
  </div>
</section>
