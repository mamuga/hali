---
import ThemeToggle from './ThemeToggle.tsx';
import { APP_URL, GITHUB_URL } from '../config';

const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#stack', label: 'Stack' },
];
---

<header class="sticky top-0 z-20 border-b border-border bg-background/95 backdrop-blur-none">
  <div class="mx-auto flex h-14 w-full max-w-[1120px] items-center gap-6 px-5 sm:px-8">
    <a href="/" class="text-[17px] tracking-[0.14em] text-wordmark">HALI</a>

    <nav class="ml-auto hidden items-center gap-6 text-[14px] text-muted-foreground md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b border-transparent pb-0.5 transition-colors hover:border-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={GITHUB_URL}
        rel="noopener"
        class="border-b border-transparent pb-0.5 transition-colors hover:border-accent hover:text-foreground"
      >
        Source
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <ThemeToggle client:load />
      <a
        href={APP_URL}
        rel="noopener"
        class="rounded-sm bg-accent px-3.5 py-1.5 text-[14px] text-accent-ink transition-opacity hover:opacity-90"
      >
        Open the app
      </a>
    </div>
  </div>
</header>
