---
import { APP_URL, GITHUB_URL, USSD_CODE } from '../config';
import { team } from '../data/site';

const year = new Date().getFullYear();
---

<footer>
  <div
    class="mx-auto grid w-full max-w-[1120px] gap-8 px-5 py-12 text-[14px] sm:grid-cols-3 sm:px-8"
  >
    <div>
      <p class="text-[17px] tracking-[0.14em] text-wordmark">HALI</p>
      <p class="mt-3 max-w-[280px] text-muted-foreground">
        Hyper-local early warning for the IGAD region. Built for IGAD Hackathon {year}.
      </p>
    </div>

    <div>
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-muted-foreground">
        Reach it
      </p>
      <ul class="mt-3 space-y-2 text-muted-foreground">
        <li>
          <a href={APP_URL} rel="noopener" class="transition-colors hover:text-foreground">
            Web app
          </a>
        </li>
        <li>
          <span>USSD </span><code class="font-mono text-foreground">{USSD_CODE}</code>
        </li>
        <li>
          <a href={GITHUB_URL} rel="noopener" class="transition-colors hover:text-foreground">
            Source on GitHub
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-muted-foreground">
        Team
      </p>
      <ul class="mt-3 space-y-3 text-muted-foreground">
        {
          team.map((member) => (
            <li>
              <span class="block text-foreground">{member.name}</span>
              <a
                href={`mailto:${member.email}`}
                class="block transition-colors hover:text-foreground"
              >
                {member.email}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
